---
import '../styles/global.css';
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Sebuah undangan untuk berbagi kebahagiaan bersama orang-orang terkasih." />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#772b40" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#invitation">Lewati pembuka</a>
    <slot />
  </body>
</html>
