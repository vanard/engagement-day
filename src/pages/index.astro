---
import InvitationLayout from '../layouts/InvitationLayout.astro';
import IntroCover from '../components/IntroCover.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import Wishes from '../components/Wishes.astro';
import RibbonFrame from '../components/RibbonFrame.astro';
import TableIllustration from '../components/TableIllustration.astro';
import { invitation } from '../content/invitation';
---
<InvitationLayout title={`Lamaran ${invitation.couple.groom} & ${invitation.couple.bride}`}>
  <IntroCover />
  <main id="invitation" tabindex="-1">
    <aside class="desktop-note" aria-hidden="true"><p class="eyebrow">A celebration of love</p><p class="side-names">{invitation.couple.groom} <span>&amp;</span> {invitation.couple.bride}</p><div class="fine-rule"></div><p class="side-date">{invitation.event.dateStamp}</p><p class="side-message">A new chapter,<br />with our favourite people.</p><span class="side-heart">♡</span></aside>
    <div class="reading-column">
      <nav aria-label="Navigasi undangan"><a href="#welcome" class="monogram" aria-label="Pembuka">{invitation.couple.groom.charAt(0)} <em>&amp;</em> {invitation.couple.bride.charAt(0)}</a><div><a href="#event">Acara</a><a href="#wishes">Doa &amp; ucapan</a></div></nav>
      <div class="invitation-paper">
        <section id="welcome" class="welcome section center">
          <RibbonFrame />
          <div class="foreground" data-reveal>
            <p class="eyebrow">Together with our families</p>
            <h1>We're Engaged</h1>
            <p class="introduction">Come celebrate love<br />and a brand new chapter with us.</p>
            <div class="portrait-frame">
              <img class="portrait engaged" src={invitation.artwork.engaged} srcset={`${invitation.artwork.engagedSmall} 620w, ${invitation.artwork.engaged} 930w`} sizes="310px" width="930" height="930" alt="Ilustrasi Vian dan Ghea memperlihatkan cincin lamaran" />
              <img class="lilies" src="/images/pink-lilies.svg" width="240" height="200" alt="" />
            </div>
            <h2 class="names">{invitation.couple.groom}<span>&amp;</span>{invitation.couple.bride}</h2>
            <p class="greeting">{invitation.greeting}</p>
            <a class="text-link" href="#event">Simpan hari bahagia kami <span aria-hidden="true">↓</span></a>
          </div>
        </section>
        <section id="event" class="section event center">
          <RibbonFrame />
          <div class="foreground" data-reveal>
            <p class="eyebrow">You're invited to our engagement</p>
            <h2>Save the Date</h2>
            <p class="event-intro">Satu langkah lebih dekat<br />menuju cerita kita selamanya.</p>
            <div class="event-card">
              <h3>Acara Lamaran</h3>
              <p class="event-date">{invitation.event.dateLabel}</p>
              <div class="fine-rule" aria-hidden="true"></div>
              <p class="event-time">{invitation.event.timeLabel}</p>
              <p class="venue">{invitation.event.venue}</p>
              <p class="address muted">{invitation.event.address}</p>
              {invitation.event.mapUrl && <a class="button outline" href={invitation.event.mapUrl} target="_blank" rel="noopener noreferrer">Lihat lokasi <span aria-hidden="true">↗</span></a>}
            </div>
            <TableIllustration />
          </div>
        </section>
        <Wishes />
        <footer class="section center">
          <RibbonFrame sage />
          <div class="foreground" data-reveal>
            <p class="eyebrow">With love, always</p>
            <h2><span class="starred">{invitation.couple.groom} &amp; {invitation.couple.bride}<span class="stars top" aria-hidden="true"><i>✧</i><i>✦</i><i>✧</i></span></span></h2>
            <img class="portrait bouquet" src={invitation.artwork.bouquet} srcset={`${invitation.artwork.bouquetSmall} 580w, ${invitation.artwork.bouquet} 870w`} sizes="290px" width="870" height="1304" alt="Ilustrasi Vian bersama Ghea yang membawa buket bunga" loading="lazy" />
            <p class="see-you"><span class="starred">See you there!<span class="stars bottom" aria-hidden="true"><i>✧</i><i>✦</i><i>✧</i></span></span></p>
            <p class="closing">Terima kasih untuk doa dan cinta Anda<br />di awal perjalanan kami.</p>
            <p class="eyebrow endnote">THE ENGAGEMENT · {invitation.event.dateStamp}</p>
          </div>
        </footer>
      </div>
    </div>
  </main>
  <MusicPlayer />
  <script>
    import { initInvitation } from '../scripts/invitation';
    initInvitation();
  </script>
</InvitationLayout>
<style>
main { max-width:1320px; margin:0 auto; padding:0 1.25rem 2.5rem; } main:focus { outline:none; }
.desktop-note { display:none; }.reading-column { width:min(100%,600px); margin:auto; }
nav { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:.6rem .7rem; }nav div { display:flex; gap:1.5rem; }nav a { display:inline-flex; align-items:center; min-height:44px; text-decoration:none; font-size:.7rem; letter-spacing:.04em; }nav .monogram { font-family:var(--font-display); font-size:1.5rem; gap:.4rem; }.monogram em { font-family:var(--font-script); }
.invitation-paper { background:var(--paper); box-shadow:0 6px 40px #51323212; }.foreground { position:relative; }.section { position:relative; padding:5.5rem 3.5rem 4.5rem; }
h1, .event h2, footer h2 { font-family:var(--font-script); font-size:clamp(3rem,8vw,4.5rem); line-height:1.2; margin:1.5rem 0; }h1 { color:#8d3048; }
.introduction, .greeting, .event-intro, .closing { font-family:var(--font-display); font-size:1.15rem; line-height:1.6; }.introduction { margin-bottom:1.8rem; }.portrait { display:block; height:auto; max-width:100%; mix-blend-mode:multiply; margin-inline:auto; }.engaged { width:310px; }.portrait-frame { position:relative; width:310px; max-width:100%; margin-inline:auto; }.lilies { position:absolute; top:-10%; right:-10%; width:46%; height:auto; pointer-events:none; }.bouquet { width:290px; margin-top:2rem; }
.names { font-family:var(--font-display); font-size:clamp(1.75rem,5vw,2.4rem); margin:1.8rem 0; }.names span { display:block; font-family:var(--font-script); font-size:1.7rem; margin:.3rem; }.greeting { margin:1.4rem auto; max-width:350px; color:var(--muted); }.text-link { display:inline-flex; gap:1rem; align-items:center; min-height:44px; font-size:.7rem; text-decoration:none; border-bottom:1px solid var(--line); }
.event { margin-top:1rem; }.event-intro { color:var(--muted); }.event-card { margin:2rem auto 0; }h3 { font-size:.7rem; font-family:var(--font-body); text-transform:uppercase; letter-spacing:.2em; margin-bottom:1rem; }.event-date { font-family:var(--font-display); font-size:clamp(1.6rem,5vw,2.1rem); margin-bottom:1.3rem; }.event-time { margin:1.3rem 0 .7rem; letter-spacing:.1em; font-size:.8rem; }.venue { font-family:var(--font-display); font-size:1.8rem; margin-bottom:.5rem; }.address { font-size:.7rem; max-width:260px; margin:0 auto 1.3rem; }
footer { color:#5e6845; margin-top:2rem; }footer h2 { margin-bottom:1rem; }.see-you { font-family:var(--font-script); font-size:3rem; margin:1.5rem 0; }.starred { position:relative; display:inline-block; }.stars { position:absolute; width:3rem; height:3rem; font-family:var(--font-body); font-style:normal; line-height:1; color:#4b5537; pointer-events:none; }.stars i { position:absolute; font-style:normal; }.stars.top { left:-2.3rem; top:-1.2rem; }.stars.bottom { right:-2.1rem; bottom:-1.6rem; }.stars i:nth-child(1) { left:1rem; top:0; font-size:1.9rem; }.stars i:nth-child(2) { left:0; top:1.6rem; font-size:1rem; }.stars i:nth-child(3) { left:.1rem; top:.2rem; font-size:1rem; }.endnote { margin-top:2rem; font-size:.55rem; }
@media(min-width:1000px) { main { display:grid; grid-template-columns:1fr 600px; gap:4rem; padding-inline:3rem; }.desktop-note { display:flex; flex-direction:column; justify-content:center; align-items:center; height:100svh; position:sticky; top:0; text-align:center; }.side-names { font-family:var(--font-script); font-size:6rem; line-height:1.1; margin:1.5rem 0 2rem; }.side-names span { display:block; font-size:3rem; }.side-date { margin-top:2rem; letter-spacing:.25em; font-size:.8rem; }.side-message { font-family:var(--font-display); font-size:1.5rem; font-style:italic; }.side-heart { font-size:2rem; } }
@media(max-width:480px) { main { padding:0; }.section { padding-inline:2.5rem; }nav { padding-inline:1.25rem; } }
/* Opening: every welcome item bounces in together, like the invitation video. */
.is-arriving #welcome :global(.ribbon-frame) { animation:arrive-fade 1.4s ease-out backwards; }
.is-arriving #welcome .eyebrow, .is-arriving #welcome .introduction, .is-arriving #welcome .greeting, .is-arriving #welcome .text-link { animation:arrive-rise 1.4s ease-out backwards; }
.is-arriving #welcome h1, .is-arriving #welcome .names { animation:arrive-write 1.4s ease-out backwards; }
.is-arriving .portrait-frame { animation:arrive-bounce 1.4s backwards; }
.is-arriving .lilies { animation:arrive-pop 1.4s backwards; }
@keyframes arrive-fade { from { opacity:0; } }
@keyframes arrive-rise { from { opacity:0; transform:translateY(14px); } }
@keyframes arrive-write { from { clip-path:inset(-25% 100% -25% -10%); } to { clip-path:inset(-25% -10% -25% -10%); } }
@keyframes arrive-bounce {
  0% { opacity:0; transform:scale(.2); animation-timing-function:cubic-bezier(.2,.7,.4,1); }
  50% { opacity:1; transform:scale(1.08); animation-timing-function:ease-in-out; }
  72% { transform:scale(.96); animation-timing-function:ease-in-out; }
  88% { transform:scale(1.02); animation-timing-function:ease-in-out; }
  100% { transform:scale(1); }
}
@keyframes arrive-pop {
  0% { opacity:0; transform:scale(0) rotate(-30deg); animation-timing-function:cubic-bezier(.2,.7,.4,1); }
  60% { opacity:1; transform:scale(1.18) rotate(6deg); animation-timing-function:ease-in-out; }
  100% { transform:none; }
}
/* Closing card, as in the video: the portrait breathes, stars twinkle, and the
   names and "See you there!" write in when the card is revealed. */
footer .bouquet { animation:breathe 3.2s ease-in-out infinite; }
.stars i { animation:twinkle 1.8s ease-in-out infinite; }
.stars i:nth-child(2) { animation-delay:-.6s; }
.stars i:nth-child(3) { animation-delay:-1.2s; }
footer .reveal-active h2 { animation:arrive-write 1.4s .2s ease-out backwards; }
footer .reveal-active .see-you { animation:arrive-write 1.4s .6s ease-out backwards; }
@media (max-width:380px) { .stars.top { left:-1.5rem; top:-1.8rem; }.stars.bottom { right:-1.4rem; bottom:-1.9rem; } }
@keyframes breathe { 50% { transform:scale(1.04); } }
@keyframes twinkle { 50% { opacity:.35; transform:scale(.7) rotate(15deg); } }
</style>
