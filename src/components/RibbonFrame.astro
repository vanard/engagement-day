---
interface Props { sage?: boolean }
const { sage = false } = Astro.props;
---
<div class:list={['ribbon-frame', { sage }]} aria-hidden="true">
  <svg class="border" viewBox="0 0 500 800" preserveAspectRatio="none" fill="none" focusable="false">
    <path d="M245 30C170 49 96 12 42 30S30 124 23 189 42 284 25 359 38 469 24 542 40 654 26 722 84 779 145 769 212 771 250 775 346 759 421 775 472 717 476 648 459 556 477 478 460 374 477 295 459 194 475 121 448 18 390 29 306 44 255 30"/>
    <path d="M239 36C147 25 110 44 54 25S41 102 31 178 47 283 33 359 46 464 32 541 48 655 34 726 89 766 149 777 216 763 250 782 353 767 414 781 465 713 468 649 451 552 469 478 452 375 469 295 451 193 467 120 444 28 389 37 306 31 261 36" opacity=".5"/>
  </svg>
  <svg class="bow" viewBox="0 0 200 110" fill="none" stroke="currentColor" stroke-width="2" focusable="false">
    <path d="M97 45C74 5 17 4 32 33S75 58 97 45ZM103 45C125 4 182 7 167 34S128 60 103 45ZM96 42C69 20 39 17 43 31S73 44 96 47M104 42C132 20 159 20 155 31S128 45 104 47M95 44Q100 33 105 44L105 53Q100 59 95 52ZM95 52C79 65 62 53 47 78L59 75 59 90C73 78 76 67 99 55M105 52C124 66 138 53 153 78L141 75 141 90C127 78 124 66 101 55"/>
  </svg>
</div>
<style>
.ribbon-frame { position:absolute; inset:10px; pointer-events:none; color:var(--forest); }
.border { width:100%; height:100%; stroke:currentColor; stroke-width:1.3; }
.bow { position:absolute; width:150px; height:83px; top:-12px; left:50%; transform:translateX(-50%); background:var(--paper); }
.sage { color:#737b4e; }
.sage .bow { display:none; }
</style>
